# ============================================================
# CENPOD - Environment Variables
# ============================================================
# Copy this file as .env.local and fill in your values:
#   cp .env.example .env.local
# ============================================================

# ── Shopify Connection (REQUIRED) ──────────────────────────
# Get your credentials from: https://dev.shopify.com/dashboard/
# Follow: https://shopify.dev/docs/apps/build/dev-dashboard/get-api-access-tokens
SHOPIFY_SHOP=your-shop-name
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=your-client-secret

# ── Alternative: Storefront API Token (OPTIONAL) ───────────
# If you have a Storefront API token from a custom app:
SHOPIFY_STOREFRONT_TOKEN=

# ── Database (PostgreSQL via Neon) ─────────────────────────
# Get your connection string from: https://console.neon.tech/
# Format: postgresql://username:password@ep-xxx.region.aws.neon.tech/cenpod?sslmode=require
DATABASE_URL=postgresql://username:password@ep-xxx.region.aws.neon.tech/cenpod?sslmode=require
